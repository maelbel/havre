{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Havre",
  "mainBinaryName": "havre-desktop",
  "version": "0.1.0",
  "identifier": "app.havre.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Your Havre mail, agenda and people, in a window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/havre.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/havre.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto"
        ]
      }
    }
  }
}