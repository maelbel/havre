# Copy this file to `.env` and fill it in. `.env` is ignored by git.

# --- Quick look without a real mailbox --------------------------------------
# 1 = serve sample emails (accounts can't be added in this mode).
HAVRE_DEMO=0

# --- Mail accounts ----------------------------------------------------------
# Add your accounts in the web UI: Settings › Mail accounts.
#
# Optional: an account set here is imported once, the first time Havre
# starts with an empty database (handy for scripted setups, and used by
# `havre-cli`). After that, manage it in Settings.
# Gmail: imap.gmail.com — an "app password", or better OAuth2 (below).
# Outlook / Microsoft 365: no passwords — add it in Settings with
# Authentication: OAuth2 (needs the Microsoft setup below).
# OVH: ssl0.ovh.net
HAVRE_IMAP_HOST=
HAVRE_IMAP_PORT=993
HAVRE_IMAP_USER=
HAVRE_IMAP_PASSWORD=
# Only for self-hosted mail servers with their own certificate authority:
# path to the CA certificate (PEM) to trust. Leave empty otherwise.
HAVRE_IMAP_CA_FILE=

# --- OAuth2 / Sign in with Microsoft (Microsoft 365, Outlook.com) ----------
# Microsoft mailboxes refuse passwords over IMAP. Register an app named Havre
# in Microsoft Entra (steps in the README, "Microsoft 365 and Outlook") and
# paste its "Application (client) ID" here.
HAVRE_MICROSOFT_CLIENT_ID=
# `common` works for most registrations. If yours is single-tenant
# ("this organizational directory only"), put your domain, e.g. company.com.
HAVRE_MICROSOFT_TENANT=common
# --- OAuth2 with Google (Gmail, Google Workspace) ---------------------------
# Create a "Web application" OAuth client in Google Cloud (steps in the
# README, "Gmail and Google Workspace") and paste its ID and secret here.
HAVRE_GOOGLE_CLIENT_ID=
HAVRE_GOOGLE_CLIENT_SECRET=

# Optional: the address you open Havre at, if it's behind a reverse proxy and
# the redirect URI shown in Havre is wrong. E.g. https://mail.example.com
# HAVRE_PUBLIC_URL=

# --- Server ----------------------------------------------------------------
# Where the server listens. Use 0.0.0.0:8080 to reach it from other devices.
HAVRE_BIND=127.0.0.1:8080
# Where Havre keeps its database (accounts + a local copy of each mailbox)
# and the key that encrypts your mail passwords (secret.key).
HAVRE_DATA_DIR=data
# Optional: the encryption key itself (64 hex characters), instead of
# data/secret.key — e.g. from a Docker secret. Generate one with:
#   openssl rand -hex 32
# HAVRE_SECRET_KEY=
# Forgot Havre's password? Set to 1, restart, choose a new one in the
# browser, then remove this line. Accounts and mail are kept.
# HAVRE_RESET_PASSWORD=1
# How much space opened emails may take in the local copy (MB).
# HAVRE_CACHE_MB=512
# Where the built web UI is (output of `pnpm build` in web/).
HAVRE_WEB_DIR=web/.output/public
# Log level: error, warn, info, debug, trace
RUST_LOG=havre=info,havre_core=info
