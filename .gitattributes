# Line endings: LF in the repository, whatever the system (Windows checkouts too).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.db binary

# Lockfiles: not diffed line by line in reviews.
Cargo.lock linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
